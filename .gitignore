# ---- Environments & build output -------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
.pio/
.vscode/

# ---- Private: course forms, report drafts (contain ID numbers / e-mails) ----
_private/

# ---- Large media: published as GitHub Release assets instead ----------------
promo/*.mp4

# ---- Recorded sessions: ~150 MB of raw frames. The logs (log.jsonl) stay, ---
# ---- so `radar_replay.py` still works from a fresh clone. --------------------
vision/debug_images/live_*/*.png
!vision/debug_images/live_*/report_sheet.png

# ---- Bulk calibration / aim snapshots (regenerated by the tools) ------------
vision/debug_images/aim*/*.png
vision/debug_images/ballcal/*.png
vision/debug_images/check*/*.png

# ---- OS clutter --------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# ---- Local tooling ------------------------------------------------------------
.claude/
